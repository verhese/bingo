BINGO_VARIANT=90
# Browser-accessible WebSocket URL, read at container start (restart to change).
# Leave blank to use the current host on port 3001. Example: wss://bingo.example.com
WS_PUBLIC_URL=
# Internal Docker Compose endpoint used by the Next.js API route.
GAME_SERVER_WS_URL=ws://localhost:3001
WS_PORT=3001

# PostgreSQL stores rooms and game state. The game service requires DATABASE_URL.
# Docker Compose builds DATABASE_URL itself from POSTGRES_PASSWORD; choose your own
# strong value and never commit it.
POSTGRES_PASSWORD=
# Only needed when running `npm run dev:ws` outside Docker against the Compose database;
# export it in your shell (the dev scripts do not read .env). Format:
#   postgres://bingo:<POSTGRES_PASSWORD>@localhost:5432/bingo
# DATABASE_URL=
# Optional: startup connection attempts, one per second, while the database comes up. Default 30.
# DATABASE_CONNECT_ATTEMPTS=30
